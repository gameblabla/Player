#if 1
static void *sound_callback(snd_stream_hnd_t hnd, int smp_req, int *smp_recv) {
    GenericAudio *audio;

	audio_len = std::max(0, smp_req) / (sizeof(int16_t) * SOUND_MODE); 
    
    // Ensure that we do not exceed the buffer's capacity
    if (audio_len > buffer_frames)
    {
		audio_len = buffer_frames;
	}
	
	if (smp_req > audio_len) {
		sh4_memset(sound_buffer, 0, buffer_size);
		*smp_recv = smp_req;
	} else {
		audio->Decode((uint8_t*)sound_buffer, buffer_size );
		smp_recv = audio_len;
	}
	
	//audio->Decode((uint8_t*)mixbuffs2, buffer_size);

