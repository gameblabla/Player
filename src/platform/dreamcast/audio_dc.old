static void *dc_audio_thread(void *dud)
{
	while(1)
	{
#if 1
		snd_stream_poll(snd_dc);
#else
		gpdc_snd_stream_poll();
#endif
		thd_sleep(10);
	}

	//snd_stream_destroy(snd_dc);
	//snd_stream_shutdown();

	free(mixbuffs2);

	return NULL;
}

